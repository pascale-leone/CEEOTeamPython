{
    "name": "easy-lego",
    "version": "1.0.0",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --mac"
    },
    "devDependencies": {
        "electron": "^28.3.3",
        "electron-builder": "^24.0.0"
    },
    "build": {
        "appId": "com.easylego.app",
        "productName": "EasyLego",
        "mac": {
            "target": "dmg"
        },
        "files": [
            "main.js",
            "index.html",
            "dist/server",
            "*.png"
          ],
          "extraResources": [
            {
              "from": "dist/server",
              "to": "server"
            },
            {
              "from": "index.html",
              "to": "index.html"
            },
            {
              "from": "images",
              "to": "images"
            },
            {
              "from": "../.env",
              "to": ".env"
            }
          ]
    }
}
