{
    "name": "easy-lego",
    "version": "1.0.0",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build:mac": "electron-builder --mac",
        "build:win": "electron-builder --win",
        "build": "electron-builder"
    },
    "devDependencies": {
        "electron": "^28.3.3",
        "electron-builder": "^24.0.0"
    },
    "build": {
        "appId": "com.easylego.app",
        "productName": "EasyLego",
        "files": [
            "main.js",
            "index.html",
            "*.png"
        ],
        "extraResources": [
            { "from": "index.html", "to": "index.html" },
            { "from": "images",     "to": "images"     },
        ],
        "mac": {
            "target": "dmg",
            "extraResources": [
                { "from": "dist/server", "to": "server" }
            ]
        },
        "win": {
            "target": "nsis",
            "extraResources": [
                { "from": "dist/server.exe", "to": "server.exe" }
            ]
        }
    }
}
